# Optional. Without a key every AI feature falls back to built-in rules and
# templates: the plan, deadlines and documents still work.
#
# Google Gemini (used first when set). GEMINI_MODEL defaults to gemini-flash-latest.
GOOGLE_API_KEY=
GEMINI_MODEL=

# Anthropic Claude (used when no Google key is set).
ANTHROPIC_API_KEY=

# Deadline reminders by email (https://resend.com). Without RESEND_API_KEY and MAIL_FROM a local
# dev server writes mail to .data/outbox instead of sending, and a production server shows
# "Email is not set up". MAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Civio <reminders@your-domain.com>"
# Protects /api/reminders/run, which a daily scheduler calls (vercel.json does this on Vercel).
# Without it that endpoint stays closed. Generate any long random string.
CRON_SECRET=
# Public address used in links inside emails. Defaults to the address of the request.
APP_URL=
