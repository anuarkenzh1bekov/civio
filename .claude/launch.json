{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "civio-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "port": 3000
    },
    {
      "name": "civio-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.main:app",
        "--reload"
      ],
      "cwd": "backend",
      "port": 8000
    }
  ]
}
